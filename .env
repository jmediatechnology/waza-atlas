# Copy to .env.local to override locally. Never commit real secrets.
APP_ENV=dev
APP_SECRET=
DATABASE_URL="sqlite:///%kernel.project_dir%/var/data.db"
# Where uploaded motion files are stored. Defaults to var/motions.
# MOTION_DIR=/srv/storage/motions
# Bearer token required to upload motion files. Leave empty to disable uploads.
MOTION_UPLOAD_TOKEN=
