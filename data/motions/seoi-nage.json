  {
   "t": 2.2,
   "name": "Kake",
   "en": "Execution",
   "text": "Tori straightens the legs, bends forward and pulls the left hand down past the left hip. Uke goes over tori’s right shoulder."
  },
  {
   "t": 3.1,
   "name": "Ukemi",
   "en": "Breakfall",
   "text": "Uke lands on the back in front of tori. Tori keeps hold of the sleeve to control the fall."
  }
