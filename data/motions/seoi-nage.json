   "t": 1,
   "name": "Kuzushi",
   "en": "Breaking balance",
   "text": "Tori pulls uke forward and up with the left hand, so uke rises onto the toes of the right foot."
  },
  {
   "t": 1.5,
   "name": "Tsukuri",
   "en": "Entry",
   "text": "Tori steps the right foot in front of uke’s right foot and pivots on it, turning the back to uke. The right elbow goes under uke’s right armpit, and both knees bend so tori’s hips sit below uke’s."
