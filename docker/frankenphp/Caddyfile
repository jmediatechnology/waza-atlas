{
	{$CADDY_GLOBAL_OPTIONS}

	frankenphp {
		{$FRANKENPHP_CONFIG}
	}
}

{$CADDY_EXTRA_CONFIG}

# SERVER_NAME=:80 serves plain HTTP on any host (local use, or behind a proxy).
# SERVER_NAME=waza.example.com gets a Let's Encrypt certificate automatically.
{$SERVER_NAME::80} {
	# Access log on stdout. Caddy redacts Authorization and Cookie headers by default.
	log {
		{$CADDY_SERVER_LOG_OPTIONS}
	}

	root /app/public
	encode zstd br gzip

	# The viewer's CSS and JS change rarely; let browsers keep them for a day.
	@assets path /assets/*
	header @assets Cache-Control "public, max-age=86400"

	header {
		-Server
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
	}

	{$CADDY_SERVER_EXTRA_DIRECTIVES}

	php_server
}
